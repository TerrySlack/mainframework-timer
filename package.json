{
  "name": "@mainframework/timer",
  "version": "0.2.0",
  "description": "Browser countdown and count-up timers backed by a shared Web Worker",
  "author": "Terry Slack <tslack@mainframework.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist/vanilla/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vanilla/index.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TerrySlack/mainframework-timer.git"
  },
  "bugs": {
    "url": "https://github.com/TerrySlack/mainframework-timer/issues"
  },
  "homepage": "https://github.com/TerrySlack/mainframework-timer",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "prepare": "husky",
    "clean": "rimraf dist tsconfig.tsbuildinfo -g src/**/*.js -g src/**/*.js.map",
    "lint-staged": "lint-staged",
    "lint": "eslint . --max-warnings=0 --no-warn-ignored",
    "prebuild": "pnpm clean",
    "build": "rollup -c && tsc --emitDeclarationOnly --declarationDir dist/types",
    "pretest": "pnpm build",
    "test": "vitest run --project unit",
    "test:all": "vitest run --project unit --project browser --project package",
    "test:browser": "pnpm build && vitest run --project browser",
    "test:package": "pnpm build && vitest run --project package",
    "test:types": "pnpm build && tsc -p tsconfig.test.json",
    "tscheck": "tsc --noEmit --emitDeclarationOnly false --incremental false",
    "verify": "pnpm tscheck && pnpm build && vitest run --project unit --project browser --project package && pnpm lint && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.3",
    "tar": "^7.5.22",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
